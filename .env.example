# Server configuration
PORT=3000
NODE_ENV=development

# Database configuration
# Set this to connect to a real PostgreSQL database (e.g. postgresql://user:password@localhost:5432/db)
# If left empty, the server automatically runs in Mock In-Memory Database Mode for testing.
DATABASE_URL=
DB_SSL=false

# Frontend configuration
# Allowed CORS origin
FRONTEND_URL=http://localhost:5173
